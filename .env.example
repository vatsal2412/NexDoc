# Copy this file to .env (which is git-ignored — never commit a real key)
# and fill in a real key to enable Groq-backed task-accuracy Q&A:
# qa/groq_qa.py, eval/run_real_eval.py, and the web app's "Ask a question"
# box (POST /api/ask). None of the deterministic pipeline/eval code
# (adapters/, eval/run_eval.py, run_adapter.py) needs this at all — it's
# used only by the real LLM Q&A path described in docs/eval-methodology.md.
#
# Get a key from https://console.groq.com/keys
# This enables the optional "task accuracy" /api/ask endpoint in the webapp,
# and the `eval/run_real_eval.py` script.
GROQ_API_KEY=your_api_key_here

# Optional: override the default Groq model (see qa/groq_qa.py's
# DEFAULT_MODEL / https://console.groq.com/docs/models for current names).
# GROQ_MODEL=openai/gpt-oss-120b
